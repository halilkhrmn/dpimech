import { Button, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Glyph } from "components.slint";

/// Shown by a profile shortcut while the profile starts and the app opens.
export component LaunchWindow inherits Window {
    title: "DPIMech";
    icon: @image-url("../assets/logo.png");
    no-frame: true;
    always-on-top: true;
    width: 400px;
    background: Theme.content;

    in property <image> picture;
    in property <string> heading;
    in property <string> status;
    /// "working", "done" or "error".
    in property <string> state;
    callback dismiss;
    callback open-main;

    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
    }

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        Image {
            source: picture;
            width: 56px;
            height: 56px;
            y: 0;
        }
        VerticalLayout {
            spacing: 6px;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if state == "done": Glyph { source: Icons.done; color: Theme.running; }
                if state == "error": Glyph { source: Icons.warning; color: Theme.error; }
                Text {
                    text: heading;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
            if status != "": Text {
                text: status;
                font-size: 12px;
                color: state == "error" ? Theme.error : Theme.muted;
                wrap: word-wrap;
            }
            if state == "working": ProgressIndicator { indeterminate: true; height: 4px; }
            if state == "error": HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { text: @tr("Open DPIMech"); clicked => { root.open-main(); } }
                Button { text: @tr("Close"); primary: true; clicked => { root.dismiss(); } }
            }
        }
    }

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); }
            accept
        }
    }
}
