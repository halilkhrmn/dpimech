import { Palette, Button, LineEdit, ProgressIndicator, ScrollView, ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Glyph, LogItem, Note } from "components.slint";
import { AppItem } from "editor.slint";
import { PackRow } from "lab.slint";

export struct WizardTask {
    text: string,
    state: string, // pending | running | done | failed
}

component ChoiceCard inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    min-height: 84px;
    border-radius: 10px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Palette.accent-background : Theme.border;
    background: touch.has-hover ? Theme.card-hover : Theme.card;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Text { text: title; font-size: 16px; font-weight: 600; }
        Text { text: root.text; color: Theme.muted; wrap: word-wrap; }
    }
}

component PackChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 38px;
    border-radius: 19px;
    border-width: 1px;
    border-color: selected ? Palette.accent-background : Theme.border;
    background: selected ? Palette.accent-background.transparentize(0.8) : touch.has-hover ? Theme.card-hover : Theme.card;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text { text: (selected ? "✓ " : "") + root.text; vertical-alignment: center; font-size: 14px; }
    }
}

export component Wizard inherits Rectangle {
    in property <int> step;
    in property <[PackRow]> packs;
    in-out property <string> custom-sites;
    in property <int> where;
    in property <bool> apps-supported: true;
    in property <bool> whole-supported: true;
    in property <bool> is-windows;
    in property <[AppItem]> apps;
    in property <string> isp-text;
    in property <[WizardTask]> tasks;
    in property <float> progress;
    in property <[LogItem]> logs; // newest first
    in property <string> message;
    in property <bool> busy;
    in property <bool> service-connected;
    callback choose-easy;
    callback choose-advanced;
    callback toggle-pack(int);
    callback packs-width(float);
    callback set-where(int);
    callback add-app;
    callback remove-app(int);
    callback detect-isp;
    callback install-service;
    callback next;
    callback report-problem;
    callback back;
    callback retry;
    callback finish;
    callback close;

    background: Theme.content;

    VerticalLayout {
        padding: 40px;
        spacing: 24px;
        alignment: start;

        // Header with step dots
        HorizontalLayout {
            spacing: 12px;
            Image { source: @image-url("../assets/logo.png"); width: 32px; height: 32px; }
            Text { text: "DPIMech"; font-size: 22px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            if step > 0: HorizontalLayout {
                spacing: 6px;
                alignment: center;
                for i in 5: Rectangle {
                    width: 8px; height: 8px; border-radius: 4px;
                    y: (parent.height - 8px) / 2;
                    background: i + 1 <= step ? Palette.accent-background : Theme.border;
                }
            }
            if step > 0 && step < 4: Button { text: @tr("Close"); clicked => { root.close(); } }
        }

        // 0 — welcome
        if step == 0: VerticalLayout {
            spacing: 16px;
            Text { text: @tr("Welcome!"); font-size: 30px; font-weight: 700; }
            Text {
                text: @tr("DPIMech opens sites and apps that your internet provider blocks, without a VPN. How would you like to start?");
                wrap: word-wrap;
                color: Theme.muted;
            }
            ChoiceCard {
                title: @tr("Just make it work");
                text: @tr("Answer three simple questions; DPIMech installs what it needs, finds settings that work on your connection and turns them on. You can switch to the full interface later in Settings.");
                clicked => { root.choose-easy(); }
            }
            ChoiceCard {
                title: @tr("I know what I'm doing");
                text: @tr("Open the full interface: engines, profiles, strategy arguments and the Strategy Lab.");
                clicked => { root.choose-advanced(); }
            }
        }

        // 1 — sites
        if step == 1: VerticalLayout {
            spacing: 16px;
            Text { text: @tr("What do you want to open?"); font-size: 26px; font-weight: 700; }
            Text { text: @tr("Pick one or more. You can add other sites too."); color: Theme.muted; }
            // The rows decide nothing about the width: chips are split for the width this area gets,
            // so its minimum must not grow with the rows (that would never let it shrink again).
            Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                min-height: chip-rows.min-height;
                preferred-height: chip-rows.preferred-height;
                // Also on creation: `changed` does not fire for the first value.
                init => { root.packs-width(self.width / 1px); }
                changed width => { root.packs-width(self.width / 1px); }
                chip-rows := VerticalLayout {
                    width: parent.width;
                    spacing: 8px;
                    for row in packs: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for pack in row.packs: PackChip {
                            text: pack.name;
                            selected: pack.selected;
                            clicked => { root.toggle-pack(pack.index); }
                        }
                    }
                }
            }
            LineEdit {
                text: custom-sites;
                placeholder-text: @tr("Other sites, e.g. example.com");
                edited(t) => { custom-sites = t; }
            }
        }

        // 2 — where
        if step == 2: VerticalLayout {
            spacing: 12px;
            Text { text: @tr("Where should it work?"); font-size: 26px; font-weight: 700; }
            if apps-supported: ChoiceCard {
                title: @tr("Only in some apps (recommended)");
                text: @tr("For example only Discord. Everything else stays exactly as it is.");
                selected: where == 0;
                clicked => { root.set-where(0); }
            }
            if apps-supported && where == 0: VerticalLayout {
                spacing: 6px;
                padding-left: 16px;
                for app[i] in apps: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "• " + app.title; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: @tr("Remove"); clicked => { root.remove-app(i); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Add app"); clicked => { root.add-app(); } }
                }
            }
            if whole-supported: ChoiceCard {
                title: @tr("The whole computer");
                text: @tr("Every app, including games and voice. Uses zapret and needs the DPIMech service.");
                selected: where == 1;
                clicked => { root.set-where(1); }
            }
            if is-windows && where == 1: Note { text: @tr("Games with strict anti-cheat (for example Valorant or FACEIT) may refuse to start or disconnect you while a packet driver is active. Turn this off before playing, or unblock only the apps you need."); }
            ChoiceCard {
                title: @tr("Only when I choose (proxy)");
                text: @tr("Creates a local proxy (127.0.0.1) you can set in a browser or app.");
                selected: where == 2;
                clicked => { root.set-where(2); }
            }
        }

        // 3 — ISP
        if step == 3: VerticalLayout {
            spacing: 16px;
            Text { text: @tr("Your internet provider"); font-size: 26px; font-weight: 700; }
            Text {
                text: @tr("Knowing your provider lets DPIMech try settings made for it first. This sends your public IP address to ipwho.is. You can skip it.");
                wrap: word-wrap;
                color: Theme.muted;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Button { text: @tr("Detect my provider"); clicked => { root.detect-isp(); } }
                Text { text: isp-text; vertical-alignment: center; font-weight: 600; }
            }
            if !service-connected: VerticalLayout {
                spacing: 8px;
                Text {
                    text: @tr("DPIMech's background service is not installed yet. It is needed to run the engines. Your computer asks for administrator permission once.");
                    wrap: word-wrap;
                    color: Theme.starting;
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Install the service"); primary: true; clicked => { root.install-service(); } }
                }
            }
        }

        // 4 — working
        if step == 4: VerticalLayout {
            spacing: 14px;
            Text { text: @tr("Setting things up…"); font-size: 26px; font-weight: 700; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    ProgressIndicator { progress: progress; indeterminate: busy && progress <= 0; }
                }
                Text {
                    text: Math.round(progress * 100) + " %";
                    font-weight: 600;
                    min-width: 48px;
                    horizontal-alignment: right;
                }
            }
            for task in tasks: HorizontalLayout {
                spacing: 10px;
                Text {
                    width: 20px;
                    text: task.state == "done" ? "✓" : task.state == "failed" ? "✕" : task.state == "running" ? "…" : "○";
                    color: task.state == "done" ? Theme.running : task.state == "failed" ? Theme.error : Theme.muted;
                    font-weight: 700;
                }
                Text { text: task.text; wrap: word-wrap; horizontal-stretch: 1; color: task.state == "pending" ? Theme.muted : Palette.foreground; }
            }
            if message != "": Text { text: message; wrap: word-wrap; color: Theme.error; }
            // What the service is doing right now, newest line on top.
            Text { text: @tr("Details"); font-size: 12px; color: Theme.muted; }
            Rectangle {
                height: 150px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.muted.transparentize(0.6);
                ListView {
                    for line in logs: HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: line.time; font-family: Theme.mono; font-size: 11px; color: Theme.muted; }
                        Text {
                            text: line.text;
                            font-family: Theme.mono;
                            font-size: 11px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            color: line.level == "error" ? Theme.error : line.level == "warn" ? Theme.starting : Palette.foreground;
                        }
                    }
                }
            }
        }

        // 5 — done
        if step == 5: VerticalLayout {
            spacing: 16px;
            Text { text: @tr("All set!"); font-size: 30px; font-weight: 700; }
            Text { text: message; wrap: word-wrap; }
        }

        // Footer
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if step >= 2 && step <= 3: Button { text: @tr("Back"); clicked => { root.back(); } }
            if step >= 1 && step <= 3: Button {
                text: step == 3 ? @tr("Start") : @tr("Next");
                primary: true;
                clicked => { root.next(); }
            }
            if step == 4 && !busy: Button { text: @tr("Report this problem"); clicked => { root.report-problem(); } }
            if step == 4 && !busy: Button { text: @tr("Back"); clicked => { root.back(); } }
            if step == 4 && !busy: Button { text: @tr("Try again"); primary: true; clicked => { root.retry(); } }
            if step == 5: Button { text: @tr("Finish"); primary: true; clicked => { root.finish(); } }
        }
    }
}
