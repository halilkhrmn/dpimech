#: ui/editor.slint:344
msgid "Reliability"
msgstr "Надёжность"

#: ui/editor.slint:350
msgid "Auto-restart when stuck or crashed"
msgstr "Автоперезапуск при зависании или сбое"

#: ui/editor.slint:352
msgid "Fixes the “ping jumps to thousands after a few hours” problem without touching other profiles."
msgstr "Устраняет проблему «через несколько часов пинг растёт до тысяч», не затрагивая другие профили."

#: ui/editor.slint:365
msgid "Preventive restart every (hours)"
msgstr "Профилактический перезапуск (каждые N часов)"

#: ui/editor.slint:366
msgid "0 = never. Takes well under a second."
msgstr "0 = никогда. Занимает намного меньше секунды."

#: ui/editor.slint:377
msgid "TCP only"
msgstr "Только TCP"

#: ui/editor.slint:379
msgid "Voice/UDP goes direct. Fewer connections through the engine."
msgstr "Голос/UDP идёт напрямую. Меньше соединений через движок."

