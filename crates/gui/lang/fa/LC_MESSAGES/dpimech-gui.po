msgstr "نمایش فایل"

#: ui/report.slint:68
msgid "Send by e-mail"
msgstr "ارسال با ایمیل"

#: ui/report.slint:69
msgid "Open a GitHub issue"
msgstr "باز کردن issue در GitHub"

