msgid "Preventive restart every (hours)"
msgstr "Önleyici yeniden başlatma (saatte bir)"

#: ui/editor.slint:366
msgid "0 = never. Takes well under a second."
msgstr "0 = hiç. Bir saniyeden çok daha kısa sürer."

#: ui/editor.slint:377
msgid "TCP only"
msgstr "Sadece TCP"

#: ui/editor.slint:379
